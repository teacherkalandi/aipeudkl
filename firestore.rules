rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow connection test doc
    match /test/{docId} {
      allow read, write: if true;
    }

    // Public read for union members, write/delete for admin portal
    match /circulars/{circularId} {
      allow read: if true;
      allow create, update: if request.resource.data.title is string &&
                             request.resource.data.category is string;
      allow delete: if true;
    }

    match /executiveMembers/{memberId} {
      allow read: if true;
      allow create, update: if request.resource.data.name is string &&
                             request.resource.data.designation is string;
      allow delete: if true;
    }

    // Hero Slides for Home page (DakShiksha)
    match /heroSlides/{slideId} {
      allow read: if true;
      allow create, update: if request.resource.data.title is string;
      allow delete: if true;
    }

    // Moving News Slider / Ticker items
    match /newsSliderItems/{itemId} {
      allow read: if true;
      allow create, update: if request.resource.data.title is string;
      allow delete: if true;
    }

    // Announcements section
    match /announcements/{annId} {
      allow read: if true;
      allow create, update: if request.resource.data.title is string;
      allow delete: if true;
    }

    // Important Documents section
    match /importantDocuments/{docId} {
      allow read: if true;
      allow create, update: if request.resource.data.title is string;
      allow delete: if true;
    }

    // Notice & Circulars section
    match /noticeCirculars/{ncId} {
      allow read: if true;
      allow create, update: if request.resource.data.title is string;
      allow delete: if true;
    }

    // Shared HTML apps. Follows this project's existing admin portal write model.
    match /portalApps/{appId} {
      allow read: if true;
      allow create, update: if ((request.resource.data.keys().hasOnly(['deleted']) && request.resource.data.deleted == true) ||
         (request.resource.data.name is string && request.resource.data.name.size() > 0 &&
          request.resource.data.category is string && request.resource.data.description is string &&
          request.resource.data.url is string &&
          (!('htmlContent' in request.resource.data) ||
           (request.resource.data.htmlContent is string && request.resource.data.htmlContent.size() <= 716800))));
    }

    // Union Documents & Rulings section (Executive Bearers)
    match /unionDocumentsAndRulings/{docId} {
      allow read: if true;
      allow create, update: if request.resource.data.title is string;
      allow delete: if true;
    }
  }
}

